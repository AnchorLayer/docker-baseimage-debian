            {
              "id": "CVE-2026-40228-libudev1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-40228 low vulnerability for libudev1 package"
              },
              "fullDescription": {
