            {
              "id": "CVE-2026-10536-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-10536 critical vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A use-after-free vulnerability exists in libcurl when an application configures an HTTP/2 stream-dependency tree via `CURLOPT_STREAM_DEPENDS` or `CURLOPT_STREAM_DEPENDS_E`, subsequently invokes `curl_easy_reset()`, and finally terminates the handle with `curl_easy_cleanup()`. During this final cleanup phase, libcurl attempts to access and modify an internal structure that was already freed during the reset operation."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-10536",
              "help": {
                "text": "Vulnerability CVE-2026-10536\nSeverity: critical\nPackage: curl\nVersion: 8.14.1-2+deb13u5\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-10536](https://security-tracker.debian.org/tracker/CVE-2026-10536)",
                "markdown": "**Vulnerability CVE-2026-10536**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | curl  | 8.14.1-2+deb13u5  |   | deb  | /var/lib/dpkg/status  | debian:distro:debian:13  | [CVE-2026-10536](https://security-tracker.debian.org/tracker/CVE-2026-10536)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/curl@8.14.1-2%2Bdeb13u5?arch=amd64\u0026distro=debian-13.7"
                ],
                "security-severity": "9.8"
              }
            },
