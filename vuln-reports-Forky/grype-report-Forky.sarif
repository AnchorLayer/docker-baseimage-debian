            {
              "id": "CVE-2026-124024-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-124024 medium vulnerability for libc-bin package"
              },
              "fullDescription": {
                "text": "Converting crafted input from UCS-4 to IBM1390 or IBM1399 character encoding, in the GNU C Library version 2.3.3 and later may result in the converter reading past the end of the input buffer, causing the calling application to crash.  When converting from UCS-4, these encoders may encounter a combining base such as U+00E6 and jump ahead by 4 bytes to check the next UCS-4 code point.  The check for end of buffer however does not account for this, which may result in a buffer overread if the following code point has less than 4 bytes remaining.  Exploitation of this bug not only requires attacker control of input and encoding, but also strict control over layout of the input in memory."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-124024",
              "help": {
                "text": "Vulnerability CVE-2026-124024\nSeverity: medium\nPackage: libc-bin\nVersion: 2.43-7\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-124024](https://security-tracker.debian.org/tracker/CVE-2026-124024)",
