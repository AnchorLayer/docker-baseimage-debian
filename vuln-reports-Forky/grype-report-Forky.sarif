            {
              "id": "CVE-2026-114691-gcc-16-base",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-114691 medium vulnerability for gcc-16-base package"
              },
              "fullDescription": {
                "text": "A flaw was found in the libstdc++ component of GCC. An attacker who can provide an excessively large element count to a boolean vector (std::vector\u003cbool\u003e) constructor can trigger an integer wrap during internal memory calculations. This issue leaves the container in an inconsistent state, leading to out-of-bounds memory access and resulting in an application crash or a Denial of Service (DoS) during subsequent operations."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-114691",
              "help": {
                "text": "Vulnerability CVE-2026-114691\nSeverity: medium\nPackage: gcc-16-base\nVersion: 16.2.0-3\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-114691](https://security-tracker.debian.org/tracker/CVE-2026-114691)",
