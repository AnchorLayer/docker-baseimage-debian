            {
              "id": "CVE-2026-54411-libpam-modules",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-54411 medium vulnerability for libpam-modules package"
              },
              "fullDescription": {
                "text": "Linux-PAM through 1.7.2 contains an observable timing discrepancy (CWE-208) in the pam_userdb module's plaintext-password comparison path in modules/pam_userdb/pam_userdb.c that allows a local or network-adjacent attacker able to repeatedly drive authentication through a calling service to recover the plaintext password of a target account by measuring response-timing differences."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-54411",
              "help": {
                "text": "Vulnerability CVE-2026-54411\nSeverity: medium\nPackage: libpam-modules\nVersion: 1.7.0-8\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-54411](https://security-tracker.debian.org/tracker/CVE-2026-54411)",
                "markdown": "**Vulnerability CVE-2026-54411**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | libpam-modules  | 1.7.0-8  |   | deb  | /var/lib/dpkg/status  | debian:distro:debian:unstable  | [CVE-2026-54411](https://security-tracker.debian.org/tracker/CVE-2026-54411)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libpam-modules@1.7.0-8?arch=amd64\u0026distro=debian\u0026upstream=pam"
                ],
                "security-severity": "6.9"
