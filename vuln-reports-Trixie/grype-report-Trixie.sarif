            {
              "id": "CVE-2026-80229-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-80229 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When performing transfers via libcurl’s multi interface, pooled TLS connections can outlive their originating easy handles. In OpenSSL 3 provider configurations, libcurl attaches an allocated library context to the easy handle's state and passes it to OpenSSL without acquiring an ownership reference; destroying the easy handle prematurely frees this context while the active connection retains a dangling pointer, leading to a heap-use-after-free upon subsequent I/O or post-handshake operations."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-80229",
              "help": {
                "text": "Vulnerability CVE-2026-80229\nSeverity: high\nPackage: curl\nVersion: 8.14.1-2+deb13u5\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-80229](https://security-tracker.debian.org/tracker/CVE-2026-80229)",
