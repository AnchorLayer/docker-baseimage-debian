              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libgssapi-krb5-2@1.22.1-3?arch=amd64\u0026distro=debian\u0026upstream=krb5"
                ],
                "security-severity": "7.5"
              }
            },
