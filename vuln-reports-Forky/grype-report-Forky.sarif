            {
              "id": "CVE-2026-92387-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-92387 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "By permanently omitting the final control-response line, a malicious FTP, IMAP, POP3, or SMTP server can exploit libcurl and completely bypass its configured transfer timeout mechanism, indefinitely blocking all concurrent transfers bound to the same multi-handle."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-92387",
              "help": {
                "text": "Vulnerability CVE-2026-92387\nSeverity: high\nPackage: curl\nVersion: 8.22.0-1\nFix Version: 8.23.0~rc1-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-92387](https://security-tracker.debian.org/tracker/CVE-2026-92387)",
