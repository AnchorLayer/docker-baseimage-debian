            {
              "id": "CVE-2026-115455-libgcc-s1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-115455 low vulnerability for libgcc-s1 package"
              },
              "fullDescription": {
                "text": "A flaw was found in GCC libstdc++. When an application extracts data into a bitset from a wide-character stream, internal stack memory allocation fails to properly account for character size and alignment. An attacker capable of supplying crafted input to an affected application could trigger a stack-based buffer overflow leading denial of service (DoS)."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-115455",
