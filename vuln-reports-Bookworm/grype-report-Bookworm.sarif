                "markdown": "**Vulnerability CVE-2026-8927**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | libcurl4  | 7.88.1-10+deb12u15  |   | deb  | /var/lib/dpkg/status  | debian:distro:debian:12  | [CVE-2026-8927](https://security-tracker.debian.org/tracker/CVE-2026-8927)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libcurl4@7.88.1-10%2Bdeb12u15?arch=amd64\u0026distro=debian-12\u0026upstream=curl"
