            {
              "id": "CVE-2026-112320-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-112320 high vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
                "text": "The GSS-RPC transport layer in MIT Kerberos 5 (aka krb5) 1.4 and later does not release the previous authentication context when a client switches from an RPCSEC_GSS or AUTH_GSSAPI flavor to a non-GSS flavor on the same TCP connection. This allows remote attackers to cause a denial of service (memory exhaustion in kadmind) by repeatedly establishing and abandoning GSS authentication contexts."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-112320",
              "help": {
                "text": "Vulnerability CVE-2026-112320\nSeverity: high\nPackage: libgssapi-krb5-2\nVersion: 1.22.1-3\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-112320](https://security-tracker.debian.org/tracker/CVE-2026-112320)",
