            {
              "id": "CVE-2026-112319-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-112319 medium vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
                "text": "The GSS-RPC layer in MIT Kerberos 5 (aka krb5) does not enforce size limits on XDR-decoded data, which allows remote authenticated users to cause a denial of service (memory exhaustion or excessive CPU consumption in kadmind) via crafted RPC requests that trigger unbounded memory allocations during XDR decoding."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-112319",
