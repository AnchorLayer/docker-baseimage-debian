            {
              "id": "CVE-2026-87864-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-87864 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "Enabling `CURLOPT_CRLF` causes curl to advertise the raw input byte count in the `IMAP APPEND {N}` literal while transmitting line-ending expanded data. The server reads only $N$ bytes for the payload, causing the remaining overflow bytes to be interpreted and executed as pipelined IMAP commands within the authenticated session."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-87864",
              "help": {
                "text": "Vulnerability CVE-2026-87864\nSeverity: high\nPackage: curl\nVersion: 8.14.1-2+deb13u7\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-87864](https://security-tracker.debian.org/tracker/CVE-2026-87864)",
