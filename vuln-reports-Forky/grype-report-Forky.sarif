  "runs": [
    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.122.1",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "CVE-2026-112314-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-112314 high vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
                "text": "clnttcp_call() in lib/rpc/clnt_tcp.c in MIT Kerberos 5 (aka krb5) does not free the RPC reply verifier between retries, which allows remote attackers to cause a denial of service (memory leak in GSS-RPC client programs) by injecting RPC replies with mismatched XIDs or by triggering authentication retries."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-112314",
              "help": {
                "text": "Vulnerability CVE-2026-112314\nSeverity: high\nPackage: libgssapi-krb5-2\nVersion: 1.22.1-3\nFix Version: 1.22.3-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-112314](https://security-tracker.debian.org/tracker/CVE-2026-112314)",
                "markdown": "**Vulnerability CVE-2026-112314**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | libgssapi-krb5-2  | 1.22.1-3  | 1.22.3-1  | deb  | /var/lib/dpkg/status  | debian:distro:debian:unstable  | [CVE-2026-112314](https://security-tracker.debian.org/tracker/CVE-2026-112314)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/libgssapi-krb5-2@1.22.1-3?arch=amd64\u0026distro=debian\u0026upstream=krb5"
                ],
                "security-severity": "7.5"
              }
            },
