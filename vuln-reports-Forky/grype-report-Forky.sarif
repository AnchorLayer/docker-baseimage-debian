            {
              "id": "CVE-2026-75805-openssl-provider-legacy",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-75805 medium vulnerability for openssl-provider-legacy package"
