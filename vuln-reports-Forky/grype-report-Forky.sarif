            {
              "id": "CVE-2023-31439-libsystemd0",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2023-31439 low vulnerability for libsystemd0 package"
              },
              "fullDescription": {
