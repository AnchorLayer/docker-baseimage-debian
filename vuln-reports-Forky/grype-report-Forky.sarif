            {
              "id": "CVE-2026-92390-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-92390 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When invoked with `--remote-header-name` (`-J`), curl fails to preserve its documented anti-clobbering protection if an intermediate 103 Early Hints response precedes the final HTTP response, or if an `ETag` header is processed before `Content-Disposition` under `--etag-save`. This flaw allows an HTTP(S) server to overwrite an existing local file specified in the `Content-Disposition` header despite the presence of the `-J` non-overwrite constraint."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-92390",
              "help": {
                "text": "Vulnerability CVE-2026-92390\nSeverity: high\nPackage: curl\nVersion: 8.22.0-1\nFix Version: 8.23.0~rc1-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-92390](https://security-tracker.debian.org/tracker/CVE-2026-92390)",
