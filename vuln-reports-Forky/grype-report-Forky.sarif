            {
              "id": "CVE-2026-11564-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-11564 critical vulnerability for curl package"
              },
              "fullDescription": {
                "text": "libcurl keeps previously used connections in a connection pool for subsequent transfers to reuse if one of them matches the setup.  An easy handle that first uses default native CA trust can continue trusting the native platform store after the application switches that same handle to custom CA material for a later transfer."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-11564",
