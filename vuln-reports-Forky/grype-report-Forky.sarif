            {
              "id": "CVE-2026-107928-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-107928 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When curl is built with GnuTLS, a malicious WebSocket server can make curl send memory past its send buffer. This is due to an out of bounds read following when `gnutls_record_send()` returns a number of bytes sent **greater than the number of bytes it was given to send**. GnuTLS does that after a blocked send."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-107928",
              "help": {
                "text": "Vulnerability CVE-2026-107928\nSeverity: high\nPackage: curl\nVersion: 8.22.0-1\nFix Version: 8.23.0-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-107928](https://security-tracker.debian.org/tracker/CVE-2026-107928)",
                "markdown": "**Vulnerability CVE-2026-107928**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | curl  | 8.22.0-1  | 8.23.0-1  | deb  | /var/lib/dpkg/status  | debian:distro:debian:unstable  | [CVE-2026-107928](https://security-tracker.debian.org/tracker/CVE-2026-107928)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/curl@8.22.0-1?arch=amd64\u0026distro=debian"
