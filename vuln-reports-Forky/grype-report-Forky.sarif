            {
              "id": "CVE-2026-92391-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-92391 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A deeply nested multipart MIME structure constructed via the public API causes a stack overflow in libcurl during normal cleanup operations. An excessive recursion depth within `curl_mime_free` leads to unbounded stack frame allocation during structure traversal, ultimately crashing the host process."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-92391",
              "help": {
                "text": "Vulnerability CVE-2026-92391\nSeverity: high\nPackage: curl\nVersion: 8.22.0-1\nFix Version: 8.23.0~rc1-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-92391](https://security-tracker.debian.org/tracker/CVE-2026-92391)",
                "markdown": "**Vulnerability CVE-2026-92391**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | curl  | 8.22.0-1  | 8.23.0~rc1-1  | deb  | /var/lib/dpkg/status  | debian:distro:debian:unstable  | [CVE-2026-92391](https://security-tracker.debian.org/tracker/CVE-2026-92391)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/curl@8.22.0-1?arch=amd64\u0026distro=debian"
                ],
                "security-severity": "7.5"
              }
            },
