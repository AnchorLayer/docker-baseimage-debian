            {
              "id": "CVE-2026-86415-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-86415 low vulnerability for curl package"
              },
              "fullDescription": {
                "text": "libcurl's connection cache match function never considers the automatic client certificate option, so a cached, already authenticated Schannel connection can be handed to a transfer that got redirected to a different origin, even though the code explicitly switched off the auto client cert option for that transfer to prevent exactly this."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-86415",
              "help": {
                "text": "Vulnerability CVE-2026-86415\nSeverity: low\nPackage: curl\nVersion: 8.22.0-1\nFix Version: 8.23.0~rc1-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-86415](https://security-tracker.debian.org/tracker/CVE-2026-86415)",
