              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/liblzma5@5.4.1-1%2Bdeb12u1?arch=amd64\u0026distro=debian-12\u0026upstream=xz-utils"
                ],
                "security-severity": "5.3"
              }
