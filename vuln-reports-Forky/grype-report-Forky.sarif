            {
              "id": "CVE-2026-129483-libsasl2-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-129483 low vulnerability for libsasl2-2 package"
              },
              "fullDescription": {
                "text": "Cyrus SASL through 2.1.28 contains an authentication bypass vulnerability in the SRP server mechanism because srp_server_mech_step2 does not reject client public values A that are multiples of N. Unauthenticated network clients can send A equal to N to force a zero shared secret, authenticating as any existing user without the password and learning session keys."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-129483",
              "help": {
                "text": "Vulnerability CVE-2026-129483\nSeverity: low\nPackage: libsasl2-2\nVersion: 2.1.28+dfsg1-12\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-129483](https://security-tracker.debian.org/tracker/CVE-2026-129483)",
