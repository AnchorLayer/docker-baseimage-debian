            {
              "id": "CVE-2026-82208-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-82208 low vulnerability for curl package"
              },
              "fullDescription": {
                "text": "With the wolfSSL backend, when CA caching is enabled and an `CURLOPT_SSL_CTX_FUNCTION` callback replaces the trust store, libcurl can silently reinstall the cached store after the callback returns. A certificate trusted by the cached store but rejected by the callback-selected store is then incorrectly accepted."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-82208",
              "help": {
                "text": "Vulnerability CVE-2026-82208\nSeverity: low\nPackage: curl\nVersion: 8.14.1-2+deb13u5\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-82208](https://security-tracker.debian.org/tracker/CVE-2026-82208)",
