            {
              "id": "CVE-2026-124851-libzstd1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-124851 low vulnerability for libzstd1 package"
              },
              "fullDescription": {
                "text": "An information disclosure vulnerability in Zstandard versions 1.5.1 through 1.5.7 allows specially crafted compressed data to expose the contents of an internal buffer through decompressed output. The buffer is 64 KiB in the default configuration and may contain uninitialized memory or literals from earlier decompressions performed using the same decompression context. An attacker who can submit compressed data and observe the resulting output can recover the buffer's contents."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-124851",
              "help": {
                "text": "Vulnerability CVE-2026-124851\nSeverity: low\nPackage: libzstd1\nVersion: 1.5.7+dfsg-4\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-124851](https://security-tracker.debian.org/tracker/CVE-2026-124851)",
