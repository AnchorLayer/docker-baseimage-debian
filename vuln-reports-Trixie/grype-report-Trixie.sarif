            {
              "id": "CVE-2026-19931-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-19931 critical vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A flaw in libcurl makes it wrongly reuse an HTTP connection setup for a given hostname using Negotiate authentication, when the initial request is done using empty credentials. This can make user B's request get sent over user A's previously authenticated connection."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-19931",
              "help": {
                "text": "Vulnerability CVE-2026-19931\nSeverity: critical\nPackage: curl\nVersion: 8.14.1-2+deb13u5\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-19931](https://security-tracker.debian.org/tracker/CVE-2026-19931)",
                "markdown": "**Vulnerability CVE-2026-19931**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | curl  | 8.14.1-2+deb13u5  |   | deb  | /var/lib/dpkg/status  | debian:distro:debian:13  | [CVE-2026-19931](https://security-tracker.debian.org/tracker/CVE-2026-19931)  |\n"
              },
              "properties": {
                "purls": [
