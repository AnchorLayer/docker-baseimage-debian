              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/perl-base@5.40.1-8?arch=amd64\u0026distro=debian\u0026upstream=perl"
                ],
                "security-severity": "9.1"
              }
            },
            {
              "id": "CVE-2026-11586-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-11586 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "By default, curl automatically responds to WebSocket PING frames. Because curl lacks an upper bound on memory allocation for unacknowledged frames, a malicious server can exhaust all available memory by flooding curl with rapid, sequential PING messages."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-11586",
