            {
              "id": "CVE-2026-87866-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-87866 low vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When built with wolfSSL, curl can successfully validate a pinned public key hash against a key the TLS peer does not possess. During the TLS handshake, wolfSSL validates the connection, but curl's subsequent re-parsing of the same certificate - tricked by a manipulated validity length field - extracts and matches a different embedded key, incorrectly authorizing the pinned public key."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-87866",
              "help": {
                "text": "Vulnerability CVE-2026-87866\nSeverity: low\nPackage: curl\nVersion: 8.14.1-2+deb13u7\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-87866](https://security-tracker.debian.org/tracker/CVE-2026-87866)",
