              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/dash@0.5.12-12?arch=amd64\u0026distro=debian"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CVE-2026-91094-dpkg",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-91094 low vulnerability for dpkg package"
              },
              "fullDescription": {
                "text": "A directory traversal bug was discovered when unpacking 3.0 (quilt) source packages, where the packaging tarball could contain the quilt database directory (.pc) with attacker controlled symlinks, where that in combination with patches that would fail to apply, could be used to make the code used to restore the backup files to either modify or remove the files pointed to by the attacker controlled symlinks."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-91094",
