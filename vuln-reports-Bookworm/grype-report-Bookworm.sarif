            {
              "id": "CVE-2025-13151-libtasn1-6",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2025-13151 high vulnerability for libtasn1-6 package"
              },
              "fullDescription": {
                "text": "Stack-based buffer overflow in libtasn1 version: v4.20.0. The function fails to validate the size of input data resulting in a buffer overflow in asn1_expend_octet_string."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2025-13151",
              "help": {
                "text": "Vulnerability CVE-2025-13151\nSeverity: high\nPackage: libtasn1-6\nVersion: 4.19.0-2+deb12u1\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:12\nLink: [CVE-2025-13151](https://security-tracker.debian.org/tracker/CVE-2025-13151)",
