              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/perl-base@5.42.3-1?arch=amd64\u0026distro=debian\u0026upstream=perl"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "CVE-2026-112315-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-112315 medium vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
                "text": "The RPCSEC_GSS authentication routines in lib/rpc/authgss_prot.c in MIT Kerberos 5 (aka krb5) 1.4 and later do not free partially decoded buffers on failure, which allows remote attackers to cause a denial of service (memory leak in kadmind) via crafted RPCSEC_GSS messages."
