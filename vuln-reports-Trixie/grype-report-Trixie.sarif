            {
              "id": "CVE-2026-92390-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-92390 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When invoked with `--remote-header-name` (`-J`), curl fails to preserve its documented anti-clobbering protection if an intermediate 103 Early Hints response precedes the final HTTP response, or if an `ETag` header is processed before `Content-Disposition` under `--etag-save`. This flaw allows an HTTP(S) server to overwrite an existing local file specified in the `Content-Disposition` header despite the presence of the `-J` non-overwrite constraint."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-92390",
              "help": {
                "text": "Vulnerability CVE-2026-92390\nSeverity: high\nPackage: curl\nVersion: 8.14.1-2+deb13u7\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-92390](https://security-tracker.debian.org/tracker/CVE-2026-92390)",
                "markdown": "**Vulnerability CVE-2026-92390**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | curl  | 8.14.1-2+deb13u7  |   | deb  | /var/lib/dpkg/status  | debian:distro:debian:13  | [CVE-2026-92390](https://security-tracker.debian.org/tracker/CVE-2026-92390)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/curl@8.14.1-2%2Bdeb13u7?arch=amd64\u0026distro=debian-13.7"
                ],
                "security-severity": "7.5"
              }
            },
