            {
              "id": "CVE-2026-94265-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-94265 critical vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When processing an HTTP redirect to a URL containing userinfo (a `username:password` component), curl might erroneously retain and re-transmit the original host's HTTP Negotiate authentication state. Consequently, a malicious server can trigger a redirect containing arbitrary userinfo to force curl to send a freshly minted Kerberos ticket—generated using the ambient identity of the client process to an untrusted third-party host, effectively bypassing the domain-scoping restrictions normally enforced by the absence of `--location-trusted`."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-94265",
              "help": {
                "text": "Vulnerability CVE-2026-94265\nSeverity: critical\nPackage: curl\nVersion: 8.22.0-1\nFix Version: 8.23.0~rc2-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-94265](https://security-tracker.debian.org/tracker/CVE-2026-94265)",
                "markdown": "**Vulnerability CVE-2026-94265**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | curl  | 8.22.0-1  | 8.23.0~rc2-1  | deb  | /var/lib/dpkg/status  | debian:distro:debian:unstable  | [CVE-2026-94265](https://security-tracker.debian.org/tracker/CVE-2026-94265)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/curl@8.22.0-1?arch=amd64\u0026distro=debian"
                ],
