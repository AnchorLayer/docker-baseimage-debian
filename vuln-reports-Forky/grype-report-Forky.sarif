            {
              "id": "CVE-2026-107929-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-107929 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When `CURLOPT_INTERFACE` (or the command line tool's `--interface` option) is set with one of the documented prefixes (`if!`, `host!`, `ifhost!`), that binding is not part of the connection reuse key, so a later transfer asking for a different source can silently reuse an existing connection and go out from the earlier transfer's source address"
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-107929",
              "help": {
                "text": "Vulnerability CVE-2026-107929\nSeverity: high\nPackage: curl\nVersion: 8.22.0-1\nFix Version: 8.23.0-1\nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-107929](https://security-tracker.debian.org/tracker/CVE-2026-107929)",
