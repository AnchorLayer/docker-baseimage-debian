            {
              "id": "CVE-2026-5704-tar",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-5704 medium vulnerability for tar package"
              },
              "fullDescription": {
                "text": "A flaw was found in tar. A remote attacker could exploit this vulnerability by crafting a malicious archive, leading to hidden file injection with fully attacker-controlled content. This bypasses pre-extraction inspection mechanisms, potentially allowing an attacker to introduce malicious files onto a system without detection."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-5704",
              "help": {
                "text": "Vulnerability CVE-2026-5704\nSeverity: medium\nPackage: tar\nVersion: 1.35+dfsg-5\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-5704](https://security-tracker.debian.org/tracker/CVE-2026-5704)",
                "markdown": "**Vulnerability CVE-2026-5704**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | tar  | 1.35+dfsg-5  |   | deb  | /var/lib/dpkg/status  | debian:distro:debian:unstable  | [CVE-2026-5704](https://security-tracker.debian.org/tracker/CVE-2026-5704)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/tar@1.35%2Bdfsg-5?arch=amd64\u0026distro=debian"
                ],
                "security-severity": "5.5"
