            {
              "id": "CVE-2026-86413-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-86413 critical vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When using an *ambient user* in a first transfer doing Negotiate authentication and asked to follow redirects, curl could pass on its credential details to an unrelated second origin when asked to redirect there."
