            },
            {
              "id": "CVE-2026-102473-dash",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-102473 low vulnerability for dash package"
              },
              "fullDescription": {
                "text": "A flaw was found in dash. When built without libc fnmatch, the internal pmatch() matcher implements * by unbounded recursion over candidate positions. A local user who can plant filenames, or otherwise feed that matcher, can make a short multi-star pattern such as *.*.*.*.*.tar.gz consume excessive CPU."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-102473",
              "help": {
                "text": "Vulnerability CVE-2026-102473\nSeverity: low\nPackage: dash\nVersion: 0.5.12-12\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:unstable\nLink: [CVE-2026-102473](https://security-tracker.debian.org/tracker/CVE-2026-102473)",
