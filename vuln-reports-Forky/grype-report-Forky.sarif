            {
              "id": "CVE-2026-87865-libcurl4t64",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-87865 high vulnerability for libcurl4t64 package"
              },
              "fullDescription": {
                "text": "When libcurl uses libssh2 with a hashed `known_hosts` file, an unrelated initial entry can cause host key validation to report a key *mismatch* as a *missing* key to the `CURLOPT_SSH_KEYFUNCTION` callback."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-87865",
