            {
              "id": "CVE-2026-112316-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-112316 medium vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
                "text": "xdr_krb5_tl_data() in lib/kadm5/kadm_rpc_xdr.c in MIT Kerberos 5 (aka krb5) does not free partially decoded data on failure, which allows remote authenticated users to cause a denial of service (memory leak in kadmind) via crafted RPC requests that trigger a decode failure."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-112316",
