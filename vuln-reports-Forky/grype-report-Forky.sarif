            {
              "id": "CVE-2026-107928-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-107928 low vulnerability for curl package"
              },
              "fullDescription": {
                "text": "When curl is built with GnuTLS, a malicious WebSocket server can make curl send memory past its send buffer. This is due to an out of bounds read following when `gnutls_record_send()` returns a number of bytes sent **greater than the number of bytes it was given to send**. GnuTLS does that after a blocked send."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-107928",
