            {
              "id": "CVE-2026-11856-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-11856 critical vulnerability for curl package"
              },
              "fullDescription": {
                "text": "Successfully using libcurl to do a transfer to a specific HTTP origin (`hostA`) with **Digest** authentication and then changing the origin to a different one (`hostB`) for a second transfer, reusing the same handle, makes libcurl wrongly pass on the  `Authorization:` header field meant for `hostA`, to `hostB`."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-11856",
              "help": {
                "text": "Vulnerability CVE-2026-11856\nSeverity: critical\nPackage: curl\nVersion: 8.14.1-2+deb13u5\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-11856](https://security-tracker.debian.org/tracker/CVE-2026-11856)",
                "markdown": "**Vulnerability CVE-2026-11856**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| critical  | curl  | 8.14.1-2+deb13u5  |   | deb  | /var/lib/dpkg/status  | debian:distro:debian:13  | [CVE-2026-11856](https://security-tracker.debian.org/tracker/CVE-2026-11856)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/debian/curl@8.14.1-2%2Bdeb13u5?arch=amd64\u0026distro=debian-13.7"
                ],
                "security-severity": "9.8"
              }
