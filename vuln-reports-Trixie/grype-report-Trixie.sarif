            {
              "id": "CVE-2026-86409-curl",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-86409 high vulnerability for curl package"
              },
              "fullDescription": {
                "text": "Setting `CURLOPT_AWS_SIGV4` to NULL but does not disable SigV4 authentication, contrary to expectations and documentation. A subsequent transfer on the same handle still sends an `Authorization: AWS4-HMAC-SHA256` header to whatever URL isset next, leaking state information."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-86409",
              "help": {
                "text": "Vulnerability CVE-2026-86409\nSeverity: high\nPackage: curl\nVersion: 8.14.1-2+deb13u7\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/status\nData Namespace: debian:distro:debian:13\nLink: [CVE-2026-86409](https://security-tracker.debian.org/tracker/CVE-2026-86409)",
