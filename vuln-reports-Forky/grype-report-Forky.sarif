            {
              "id": "CVE-2026-119079-libgssapi-krb5-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-119079 high vulnerability for libgssapi-krb5-2 package"
              },
              "fullDescription": {
                "text": "decode_sequence_of() in lib/krb5/asn.1/asn1_encode.c in MIT Kerberos 5 (aka krb5) 1.11 and later grows the decoded element array one entry at a time, which allows remote attackers to cause a denial of service (CPU consumption in the KDC) by sending an unauthenticated AS-REQ or TGS-REQ with a large number of elements in a SEQUENCE OF field over TCP."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-119079",
