            {
              "id": "CVE-2026-132138-libsasl2-2",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-132138 medium vulnerability for libsasl2-2 package"
              },
              "fullDescription": {
                "text": "A flaw was found in cyrus-sasl. When processing authentication requests using the Salted Challenge Response Authentication Mechanism (SCRAM), a remote attacker can trigger a null pointer dereference by submitting unexpected channel-binding data. This causes the server process to crash before validating authentication proofs, leading to a Denial of Service (DoS)."
              },
              "helpUri": "https://security-tracker.debian.org/tracker/CVE-2026-132138",
              "help": {
